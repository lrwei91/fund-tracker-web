[Unit]
Description=Stock Web (恭喜发财 Web 版)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/stock-web/server
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node /opt/stock-web/server/server.js
Environment=PORT=18765
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/stock-web/data
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
